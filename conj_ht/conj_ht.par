[GENERAL] 
#startFrom = "restart.fld"
polynomialOrder = 7
stopAt = endTime
endTime = 1.0
#numSteps = 3000
dt = 1e-03
timeStepper = tombo2

writeControl = simulationTime
writeInterval = 10

[PRESSURE]
residualTol = 1e-06

[VELOCITY]
boundaryTypeMap = v, O, W
residualTol = 1e-08

[TEMPERATURE]
boundaryTypeMap = t, f, t, f, t, f, I
residualTol = 1e-08

