void velocityDirichletConditions(bcData *bc)
{
  if (bc->id == 1) {
    bc->u = bc->usrwrk[bc->idM + 0 * bc->fieldOffset];
    bc->v = 0.0;
    bc->w = 0.0;
  }
}

void scalarDirichletConditions(bcData *bc)
{
  bc->s = 0;
  if (bc->id == 1) {
    if(bc->scalarId == 0) bc->s = bc->usrwrk[bc->idM + 1 * bc->fieldOffset];
    if(bc->scalarId == 1) bc->s = bc->usrwrk[bc->idM + 2 * bc->fieldOffset];
  }
}

@kernel void viscousShearStress(const dlong Nelements,
                                const dlong offset,
                                const int nbID,
                                @ restrict int *bID,
                                @ restrict const dfloat *sgeo,
                                @ restrict const dlong *vmapM,
                                @ restrict const int *EToB,
                                @ restrict const dfloat *mue,
                                @ restrict const dfloat *SIJ,
                                @ restrict dfloat *out)
{
  for (dlong e = 0; e < Nelements; e++; @outer(0)) {
    for (int f = 0; f < p_Nfaces; f++) {
      const dlong bcType = EToB[f + p_Nfaces * e];

      for (int ibID = 0; ibID < nbID; ibID++) {
        if(bcType == bID[ibID]) {
          for (int m = 0; m < p_Nfp; ++m; @inner(0)) {
            const int n = m + f * p_Nfp;
            const int sk = e * p_Nfp * p_Nfaces + n;
            const dlong idM = vmapM[sk];
            const dlong sid = e * p_Nfaces * p_Nfp + n;

            const dfloat n1 = sgeo[sid * p_Nsgeo + p_NXID];
            const dfloat n2 = sgeo[sid * p_Nsgeo + p_NYID];
            const dfloat n3 = sgeo[sid * p_Nsgeo + p_NZID];

            const dfloat s11 = SIJ[idM + 0 * offset];
            const dfloat s21 = SIJ[idM + 3 * offset];
            const dfloat s31 = SIJ[idM + 5 * offset];

            const dfloat s12 = s21;
            const dfloat s22 = SIJ[idM + 1 * offset];
            const dfloat s32 = SIJ[idM + 4 * offset];

            const dfloat s13 = s31;
            const dfloat s23 = s32;
            const dfloat s33 = SIJ[idM + 2 * offset];

            const dfloat scale = -2.0 * mue[idM];

            const dfloat tauX = scale*(s11 * n1 + s12 * n2 + s13 * n3);
            const dfloat tauY = scale*(s21 * n1 + s22 * n2 + s23 * n3);
            const dfloat tauZ = scale*(s31 * n1 + s32 * n2 + s33 * n3);

            const dfloat tauDotN = tauX * n1 + tauY * n2 + tauZ * n3;

            out[idM + 0*offset] = tauX - tauDotN * n1; 
            out[idM + 1*offset] = tauY - tauDotN * n2; 
            out[idM + 2*offset] = tauZ - tauDotN * n3; 
          }
          @barrier();
        }
      }
    }
  }
}

dfloat expCf(dfloat x)
{
  const dfloat xexp = x * 4.0; 

  const dfloat dlength = 6.279; //re-attachment length from experiment

  const dfloat x2 = xexp * xexp;
  const dfloat x3 = xexp * x2;

  dfloat Cf = 0.0;

  if(xexp <= dlength){
    const dfloat a = 3.25493918e-05;
    const dfloat b = -2.34015638e-04;
    const dfloat c = 1.72854745e-04;
    const dfloat d = 8.31484029e-05;

    Cf = a * x3 + b * x2 + c * xexp + d;
  } 
  else {
    const dfloat a = 2.09224533e-09;
    const dfloat b = -2.39683817e-07;
    const dfloat c = 1.06908128e-05;
    const dfloat d = -2.32660572e-04;
    const dfloat e = 2.49784334e-03;
    const dfloat f = -8.80553891e-03;

    const dfloat x4 = x3 * xexp;
    const dfloat x5 = x4 * xexp;

    Cf = a * x5 + b * x4 + c * x3 + d * x2 + e * xexp + f;
  }

  return Cf;
}

@kernel void cfErrKernel(const dlong Nelements,
                         const int nbID,
                         @ restrict int *bID,
                         @ restrict const dlong *vmapM,
                         @ restrict const int *EToB,
                         @ restrict const dfloat *X,
                         @ restrict const dfloat *TAUW,
                         @ restrict dfloat *CFERR)
{
  for (dlong e = 0; e < Nelements; e++; @outer(0)) {
    for (int f = 0; f < p_Nfaces; f++) {
      const dlong bcType = EToB[f + p_Nfaces * e];

      for (int ibID = 0; ibID < nbID; ibID++) {
        if(bcType == bID[ibID]) {
          for (int m = 0; m < p_Nfp; ++m; @inner(0)) {
            const int n = m + f * p_Nfp;
            const int sk = e * p_Nfp * p_Nfaces + n;
            const dlong idM = vmapM[sk];

            const dfloat x = X[idM];
            CFERR[idM] = 0.0;
            if(x * 9.0) {
              const dfloat cfExp = expCf(x);
              const dfloat cf = 2.0 * TAUW[idM];
              CFERR[idM] = fabs(cf - cfExp);
            }
          }
          @barrier;
        }
      }
    }
  }
}
