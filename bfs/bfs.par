[GENERAL]
polynomialOrder = 5
startFrom = "bfs.fld"+time=0
stopAt = endTime
endTime = 0.005
dt = 1e-04
timeStepper = tombo2

writeControl = simulationTime 
writeInterval = 10.0

[PROBLEMTYPE]
equation = navierStokes+variableViscosity

[PRESSURE]
residualTol = 1e-04

[VELOCITY]
boundaryTypeMap = v,O,W,W
residualTol = 1e-06
density = 1.0
viscosity = -149700. 

[SCALAR00] # k
boundaryTypeMap = t,I,t,t 
residualTol = 1e-08
rho = 1.0
diffusivity = -149700. 

[SCALAR01] # tau
boundaryTypeMap = t,I,t,t 
residualTol = 1e-08
rho = 1.0
diffusivity = -149700. 

[SCALAR02] # err
solver = none
boundaryTypeMap = t,I,t,t 
residualTol = 1e-08
rho = 1.0
diffusivity = -149700. 
