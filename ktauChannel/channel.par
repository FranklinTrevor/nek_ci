[GENERAL]
polynomialOrder = 7
startFrom = "r.fld"+time=0
stopAt = endTime
endTime = 300
dt = 5e-03
timeStepper = tombo2

checkpointControl = simulationTime 
checkpointInterval = 10

constFlowRate = meanVelocity=1.0 + direction=X

scalars = k, tau

[PROBLEMTYPE]
equation = navierStokes+variableViscosity

[FLUID PRESSURE]
residualTol = 1e-04

[FLUID VELOCITY]
boundaryTypeMap = zeroDirichlet, zeroDirichletY/zeroNeumann
residualTol = 1e-06
rho = 1.0
viscosity = 1/43500. 

[SCALAR TAU]
boundaryTypeMap = udfDirichlet, zeroNeumann 
residualTol = 1e-08

[SCALAR K]
boundaryTypeMap = udfDirichlet, zeroNeumann
residualTol = 1e-08 
